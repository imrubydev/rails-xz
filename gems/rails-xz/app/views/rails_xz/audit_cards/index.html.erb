<%# Audit board: modules awaiting a decision. See docs/03-audit-engine.md. %>
<h1>rails.xz audit</h1>

<ul>
  <% @cards.each do |card| %>
    <li>
      <%= link_to card.module_name, card %>
      <span class="status"><%= card.status %></span>
      <% card.derived_effects.each do |effect| %>
        <span class="badge"><%= effect.upcase %></span>
      <% end %>
    </li>
  <% end %>
</ul>